# Server port for the local Express app
PORT=3000

# OpenRouter API key. The server reads this ONLY from .env on the server side.
# Copy this file to .env and paste your key below. Never put this key in
# coll.html or any frontend JavaScript.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use via OpenRouter. Change this any time without touching server.js.
# If not set, the server falls back to openrouter/free.
OPENROUTER_MODEL=openrouter/free

# Local Kokoro TTS server (kokoro_server.py). Leave empty for the default.
# Used by POST /api/tts, which proxies browser speech requests to this local URL.
KOKORO_TTS_URL=http://127.0.0.1:5001/tts